# Copy to .env and fill in. Bun loads .env automatically.

# Photon (Spectrum) — the whole interface runs on Spectrum
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
FOODIE_LINK=                 # the number or link users text, from the Photon dashboard

# Gemini — intent parsing (JSON-schema output) and short option reasons
GEMINI_API_KEY=
GEMINI_MODEL=                # a current Gemini Flash model; defaults to gemini-flash-latest

# Google — one OAuth client (Calendar + Contacts) and one Maps key (Places API (New) + Routes API)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# Capital One Nessie (sandbox, no real money)
NESSIE_API_KEY=

DATABASE_URL=postgres://localhost:5432/foodie
PUBLIC_BASE_URL=             # public HTTPS URL for OAuth, the link page and invites (e.g. a cloudflared tunnel)
PORT=3000
TIMEZONE=America/New_York
ENCRYPTION_KEY=              # any long random string; encrypts Google tokens at rest

# Demo
DEMO=1
DEMO_TOKEN=                  # random string; open /demo?token=...
DEMO_DATE=2026-10-10         # the demo clock runs on this date (10th of a 31-day month, as the budget numbers assume)
DEMO_AREA=Chapel Hill, NC
DEMO_ORGANIZER=Ronald
DEMO_MEMBER=Clive
DEMO_NEWCOMER=Eric
DEMO_PHONES=                 # +1... / +1... / +1...  (organizer / member / newcomer)
DEMO_GOOGLE_ACCOUNTS=        # the three Google accounts; add each as an OAuth test user

# Options
TERMINAL=0                   # 1 = also run the Spectrum terminal provider (three chats: ronald, clive, eric)
GROUP_CHAT_MODE=0            # 1 = post the vote in a real group chat when the line supports it (dedicated lines)
USE_GEMINI=1                 # 0 = rules parser only
